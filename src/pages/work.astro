---
import Layout from '../layouts/Layout.astro';
import TileGrid from '../components/TileGrid.astro';
import ExpandableTile from '../components/ExpandableTile.astro';
import work from '../content/work.json';
import type { TileItem } from '../types/content';

const items = work.items as TileItem[];
const accordionName = 'tiles-work';
---

<Layout title={work.title} description={work.intro} currentPath="/work">
	<main class="page-shell">
		<header class="page-head">
			<h1>{work.title}</h1>
			<p>{work.intro}</p>
		</header>
		<TileGrid group={accordionName}>
			{items.map((item, index) => (
				<ExpandableTile item={item} tileIndex={index} />
			))}
		</TileGrid>
	</main>
</Layout>
