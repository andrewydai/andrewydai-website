---
import Layout from '../layouts/Layout.astro';
import HobbiesCollage from '../components/HobbiesCollage.astro';
import hobbies from '../content/hobbies.json';
import type { HobbyItem } from '../types/content';

const items = hobbies.items as HobbyItem[];
---

<Layout title={hobbies.title} description={hobbies.intro} currentPath="/hobbies">
	<main class="page-shell">
		<header class="page-head">
			<h1>{hobbies.title}</h1>
			<p>{hobbies.intro}</p>
		</header>
		<HobbiesCollage items={items} />
	</main>
</Layout>
