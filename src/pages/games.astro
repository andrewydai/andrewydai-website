---
import Layout from '../layouts/Layout.astro';
import SiteStage from '../components/SiteStage.astro';
import PageHeader from '../components/PageHeader.astro';
import TileGrid from '../components/TileGrid.astro';
import ExpandableTile from '../components/ExpandableTile.astro';
import games from '../content/games.json';
import type { TileItem } from '../types/content';

const items = games.items as TileItem[];
const accordionName = 'tiles-games';
---

<Layout title={games.title} description={games.intro} currentPath="/games">
	<SiteStage>
		<main class="page-shell">
			<PageHeader title={games.title} intro={games.intro} />
			<TileGrid group={accordionName}>
				{items.map((item, index) => (
					<ExpandableTile item={item} tileIndex={index} />
				))}
			</TileGrid>
		</main>
	</SiteStage>
</Layout>
