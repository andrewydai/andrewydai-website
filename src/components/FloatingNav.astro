---
import site from '../content/site.json';

interface Props {
	currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const { social } = site;

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/work', label: 'Work' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/games', label: 'Games' },
	{ href: '/hobbies', label: 'Hobbies' },
];

const isActive = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav class="float-nav" aria-label="Primary">
	<div class="float-nav__inner">
		<div class="float-nav__pages">
			{
				links.map((l) => (
					<a href={l.href} class:list={['nav-pill', { 'nav-pill--active': isActive(l.href) }]} data-current={isActive(l.href) || undefined}>
						{l.label}
					</a>
				))
			}
		</div>
		<div class="float-nav__divider" role="presentation" />
		<div class="float-nav__social">
			<a class="social-link" href={social.github} target="_blank" rel="noreferrer noopener">
				GitHub
			</a>
			<a class="social-link" href={social.linkedin} target="_blank" rel="noreferrer noopener">
				LinkedIn
			</a>
			<a class="social-link social-link--resume" href={social.resumeUrl} download>
				Resume
			</a>
		</div>
	</div>
</nav>

<style>
	.float-nav {
		position: fixed;
		top: var(--nav-top);
		right: var(--nav-right);
		z-index: 50;
		/* Wide enough for Home · Work · Projects · Games · Hobbies on one line */
		max-width: min(46rem, calc(100vw - 2rem));
	}

	.float-nav__inner {
		background: rgba(255, 253, 248, 0.82);
		backdrop-filter: blur(14px);
		border: 1px solid rgba(28, 27, 25, 0.08);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow);
		padding: 0.75rem 1rem 0.8rem;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.float-nav__pages {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.35rem;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		padding-bottom: 0.1rem;
	}

	.nav-pill {
		font-family: var(--font-sans);
		font-size: 0.8rem;
		font-weight: 500;
		padding: 0.38rem 0.62rem;
		border-radius: 999px;
		text-decoration: none;
		color: var(--ink-muted);
		border: 1px solid transparent;
		background: transparent;
		white-space: nowrap;
		flex-shrink: 0;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.nav-pill:hover {
		color: var(--ink);
		background: rgba(28, 27, 25, 0.05);
	}

	.nav-pill--active {
		color: var(--ink);
		background: var(--accent-soft);
		border-color: rgba(47, 111, 94, 0.25);
	}

	.float-nav__divider {
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(28, 27, 25, 0.12), transparent);
	}

	.float-nav__social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.75rem;
		align-items: center;
	}

	.social-link {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--accent);
	}

	.social-link:hover {
		text-decoration: underline;
	}

	.social-link--resume {
		margin-left: auto;
		padding: 0.25rem 0.55rem;
		border-radius: 999px;
		border: 1px dashed rgba(47, 111, 94, 0.45);
		background: rgba(255, 255, 255, 0.6);
	}

	@media (max-width: 520px) {
		.float-nav {
			left: 1rem;
			right: 1rem;
			max-width: none;
		}

		.social-link--resume {
			margin-left: 0;
		}
	}
</style>
