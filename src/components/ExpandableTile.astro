---
import type { TileItem } from '../types/content';
import DetailBlocks from './DetailBlocks.astro';

interface Props {
	item: TileItem;
	tileIndex?: number;
}

const { item, tileIndex = 0 } = Astro.props;
const thumbObjectFit = item.image.objectFit ?? 'cover';
const thumbContain = thumbObjectFit === 'contain';
const stagger = `${Math.min(tileIndex, 12) * 55}ms`;
const panelId = `tile-panel-${item.id}`;
const summaryId = `tile-summary-${item.id}`;

function parseYearMonth(ym: string): { iso: string; label: string } | null {
	const m = ym.trim().match(/^(\d{4})-(\d{2})$/);
	if (!m) return null;
	const y = Number(m[1]);
	const mo = Number(m[2]);
	if (mo < 1 || mo > 12) return null;
	const d = new Date(y, mo - 1);
	return {
		iso: `${m[1]}-${m[2]}`,
		label: d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }),
	};
}

const structuredHeading = Boolean(item.organization && item.role);

let tenureParsed: {
	start: { iso: string; label: string };
	end: { iso: string; label: string } | null;
} | null = null;
if (item.tenure?.start) {
	const start = parseYearMonth(item.tenure.start);
	if (start) {
		const rawEnd = item.tenure.end;
		if (rawEnd == null || rawEnd === '') {
			tenureParsed = { start, end: null };
		} else {
			const end = parseYearMonth(rawEnd);
			if (end) tenureParsed = { start, end };
		}
	}
}
const tenureLabel = tenureParsed
	? tenureParsed.end
		? `${tenureParsed.start.label} – ${tenureParsed.end.label}`
		: `${tenureParsed.start.label} – Present`
	: null;
---

<article class="tile" data-tile-item style={`--tile-stagger: ${stagger}`}>
	<button
		type="button"
		class="tile__summary"
		id={summaryId}
		aria-expanded="false"
		aria-controls={panelId}
	>
		<div class:list={['tile__thumb', thumbContain && 'tile__thumb--contain']} aria-hidden="true">
			<img
				src={item.image.src}
				alt=""
				width="72"
				height="72"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="tile__body">
			<div class="tile__heading-row">
				<div class="tile__heading-main">
					{
						structuredHeading ? (
							<h2 class="tile__title tile__title--stacked">
								<span class="tile__company">{item.organization}</span>
								<span class="tile__role">{item.role}</span>
							</h2>
						) : (
							<h2 class="tile__title">{item.title}</h2>
						)
					}
				</div>
				{
					tenureParsed ? (
						<p class="tile__tenure" aria-label={`Employment period: ${tenureLabel}`}>
							<time datetime={tenureParsed.start.iso}>{tenureParsed.start.label}</time>
							<span class="tile__tenure-sep" aria-hidden="true">
								{' '}
								–{' '}
							</span>
							{tenureParsed.end ? (
								<time datetime={tenureParsed.end.iso}>{tenureParsed.end.label}</time>
							) : (
								<span>Present</span>
							)}
						</p>
					) : null
				}
			</div>
			<p class="tile__blurb">{item.blurb}</p>
			{item.badges.length ? (
				<ul class="tile__badges" aria-label="Skills and technologies">
					{item.badges.map((b) => (
						<li>{b}</li>
					))}
				</ul>
			) : null}
		</div>
		<span class="tile__chev" aria-hidden="true" />
	</button>
	<div
		class="tile__expand-measure"
		id={panelId}
		role="region"
		aria-labelledby={summaryId}
	>
		<div class="tile__expanded">
			<DetailBlocks blocks={item.details} />
		</div>
	</div>
</article>

<style>
	.tile {
		border-radius: var(--radius-md);
		background: rgba(255, 253, 248, 0.96);
		border: 1px solid rgba(28, 27, 25, 0.12);
		box-shadow: 0 2px 0 rgba(28, 27, 25, 0.05);
		overflow: hidden;
		transition:
			box-shadow 0.28s ease,
			border-color 0.28s ease,
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	@media (prefers-reduced-motion: no-preference) {
		.tile:hover {
			transform: translateY(-2px);
		}
	}

	.tile:hover {
		box-shadow: var(--shadow);
		border-color: rgba(31, 107, 86, 0.2);
	}

	.tile__summary {
		width: 100%;
		margin: 0;
		padding: 0.85rem 1rem 0.85rem 1.1rem;
		min-height: 4.85rem;
		border: none;
		background: transparent;
		font: inherit;
		color: inherit;
		text-align: left;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 1rem;
		transition:
			background-color 0.38s cubic-bezier(0.33, 1, 0.68, 1),
			box-shadow 0.35s ease;
	}

	.tile[data-expanded] .tile__summary {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.72) 0%, rgba(42, 143, 114, 0.06) 100%);
		box-shadow: inset 0 -1px 0 rgba(31, 107, 86, 0.12);
	}

	.tile__thumb {
		flex: 0 0 auto;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgba(31, 107, 86, 0.18);
		background: linear-gradient(145deg, var(--paper-2), #fff);
		transition: transform 0.4s cubic-bezier(0.34, 1.25, 0.64, 1);
	}

	.tile[data-expanded] .tile__thumb {
		transform: scale(1.04);
	}

	.tile__thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.tile__thumb--contain {
		padding: 0.35rem;
		background: #fff;
	}

	.tile__thumb--contain img {
		object-fit: contain;
	}

	.tile__body {
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.22rem;
	}

	.tile__heading-row {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.12rem 0.85rem;
	}

	.tile__heading-main {
		flex: 1 1 9rem;
		min-width: 0;
	}

	.tile__title {
		font-family: var(--font-serif), var(--font-emoji);
		font-size: 1.15rem;
		font-weight: 600;
		margin: 0;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--ink);
	}

	.tile__title--stacked {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.18rem;
		line-height: 1.2;
	}

	.tile__company {
		font-family: var(--font-serif), var(--font-emoji);
		font-size: 1.12rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
		line-height: 1.2;
	}

	.tile__role {
		font-family: var(--font-sans);
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--ink-muted);
		line-height: 1.3;
	}

	.tile__tenure {
		margin: 0;
		flex: 0 1 auto;
		max-width: 100%;
		margin-left: auto;
		text-align: right;
		align-self: flex-start;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.02em;
		color: rgba(74, 70, 64, 0.92);
		line-height: 1.3;
	}

	.tile__tenure time {
		font-weight: 600;
		color: var(--ink-muted);
	}

	.tile__blurb {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.92rem;
		line-height: 1.45;
	}

	.tile__badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		list-style: none;
		margin: 0.15rem 0 0;
		padding: 0;
		justify-content: flex-start;
	}

	.tile__badges li {
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.22rem 0.5rem;
		border-radius: 999px;
		color: var(--accent);
		background: linear-gradient(180deg, rgba(42, 143, 114, 0.14), rgba(31, 107, 86, 0.1));
		border: 1px solid rgba(31, 107, 86, 0.28);
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.5) inset;
	}

	.tile__chev {
		flex: 0 0 auto;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 999px;
		border: 1px solid rgba(31, 107, 86, 0.22);
		background: rgba(255, 255, 255, 0.65);
		position: relative;
		transition:
			transform 0.45s cubic-bezier(0.34, 1.35, 0.64, 1),
			background-color 0.32s ease,
			border-color 0.32s ease;
	}

	.tile[data-expanded] .tile__chev {
		background: rgba(42, 143, 114, 0.18);
		border-color: rgba(31, 107, 86, 0.35);
	}

	.tile__chev::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		width: 0.45rem;
		height: 0.45rem;
		border-right: 2px solid var(--accent);
		border-bottom: 2px solid var(--accent);
		transform: translate(-50%, -60%) rotate(45deg);
		transition: transform 0.45s cubic-bezier(0.34, 1.35, 0.64, 1);
	}

	.tile[data-expanded] .tile__chev::before {
		transform: translate(-50%, -30%) rotate(225deg);
	}

	.tile__expand-measure {
		max-height: 0;
		overflow: hidden;
		transition: max-height 0.5s cubic-bezier(0.45, 0, 0.2, 1);
	}

	.tile__expanded {
		padding: 0 1.1rem 1.25rem;
		border-top: 1px solid rgba(31, 107, 86, 0.12);
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0%, rgba(42, 143, 114, 0.05) 100%);
		opacity: 0;
		transform: translateY(-0.5rem);
		transition:
			opacity 0.38s cubic-bezier(0.45, 0, 0.2, 1),
			transform 0.42s cubic-bezier(0.45, 0, 0.2, 1);
		pointer-events: none;
	}

	.tile[data-expanded] .tile__expanded {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.tile,
		.tile__summary,
		.tile__thumb,
		.tile__chev,
		.tile__chev::before,
		.tile__expand-measure,
		.tile__expanded {
			transition: none !important;
		}

		.tile:hover {
			transform: none;
		}

		.tile[data-expanded] .tile__thumb {
			transform: none;
		}

		.tile__expand-measure {
			max-height: none;
		}

		.tile:not([data-expanded]) .tile__expand-measure {
			display: none;
		}

		.tile__expanded {
			opacity: 1;
			transform: none;
		}
	}
</style>
