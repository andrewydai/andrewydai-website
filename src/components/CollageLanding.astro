---
import site from '../content/site.json';
import SiteStage from './SiteStage.astro';

const { name, shortBio } = site.profile;
const { heroImage } = site.landing;

const [firstName, ...rest] = name.split(' ');
const lastName = rest.join(' ');
---

<SiteStage>
	<main class="page-shell landing-shell">
		<section class="landing-hero" aria-labelledby="landing-title">
			<div class="landing-hero__copy">
				<h1 id="landing-title" class="landing-title">
					<span class="landing-title__first">{firstName}</span>
					{lastName ? <span class="landing-title__last">{lastName}</span> : null}
				</h1>
				<p class="landing-blurb">{shortBio}</p>
			</div>

			<figure class="landing-hero__photo">
				<div class="landing-photo-frame">
					<img
						src={heroImage.src}
						alt={heroImage.alt}
						width="1100"
						height="760"
						fetchpriority="high"
					/>
				</div>
			</figure>
		</section>
	</main>
</SiteStage>

<style>
	.landing-shell {
		max-width: 76rem;
		padding-top: clamp(5rem, 14vh, 7.5rem);
		padding-bottom: clamp(3rem, 10vh, 5rem);
	}

	.landing-hero {
		display: grid;
		gap: 2rem;
		align-items: center;
	}

	.landing-hero__copy {
		max-width: 38rem;
	}

	.landing-title {
		margin: 0 0 1rem;
		font-family: var(--font-display), var(--font-serif), var(--font-emoji);
		font-size: clamp(3.25rem, 11vw, 6.5rem);
		font-weight: 700;
		line-height: 0.92;
		letter-spacing: -0.045em;
		opacity: 0;
		animation: page-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.05s both;
	}

	.landing-title__first {
		display: block;
		color: var(--ink);
	}

	.landing-title__last {
		display: block;
		background: linear-gradient(118deg, var(--accent) 8%, var(--accent-bright) 42%, var(--coral) 92%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.landing-blurb {
		margin: 0;
		max-width: 36ch;
		font-family: var(--font-serif), var(--font-emoji);
		font-size: clamp(1.05rem, 2vw, 1.2rem);
		line-height: 1.55;
		color: var(--ink-muted);
		opacity: 0;
		animation: page-rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.22s both;
	}

	.landing-hero__photo {
		margin: 0;
		width: fit-content;
		max-width: 100%;
		margin-inline: auto;
		opacity: 0;
		animation: landing-photo-in 1s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
	}

	.landing-photo-frame {
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid rgba(28, 27, 25, 0.1);
		box-shadow:
			0 4px 0 rgba(23, 21, 18, 0.04),
			var(--shadow);
		background: rgba(255, 253, 248, 0.95);
	}

	.landing-photo-frame img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	@keyframes landing-photo-in {
		from {
			opacity: 0;
			transform: translateY(20px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (min-width: 768px) {
		.landing-hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
			gap: 2.5rem 3rem;
		}

		.landing-hero__copy {
			padding-right: 0.5rem;
		}

		.landing-hero__photo {
			margin-inline: 0 0 auto;
		}

		.landing-photo-frame img {
			aspect-ratio: 5 / 4;
		}
	}

	@media (min-width: 1024px) {
		.landing-hero {
			min-height: calc(100vh - 12rem);
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.landing-title,
		.landing-blurb,
		.landing-hero__photo {
			animation: none;
			opacity: 1;
		}
	}
</style>
