---
import site from '../content/site.json';

type CollageText = {
	kind: 'text';
	id: string;
	body: string;
	span?: 'medium' | 'wide';
};

type CollagePhoto = {
	kind: 'photo';
	id: string;
	src: string;
	alt: string;
	caption?: string;
};

type CollageLinkCard = {
	kind: 'linkCard';
	id: string;
	href: string;
	eyebrow: string;
	title: string;
	text: string;
};

type CollagePiece = CollageText | CollagePhoto | CollageLinkCard;

const pieces = site.landingCollage as CollagePiece[];
const intro = pieces.find((piece): piece is CollageText => piece.kind === 'text' && piece.id === 'intro');
const welcomePhoto = pieces.find((piece): piece is CollagePhoto => piece.kind === 'photo');
const collagePieces = pieces.filter((piece) => piece.id !== intro?.id && piece.id !== welcomePhoto?.id);

const rotationClass = (index: number) => `landing-rot--${index % 7}`;
const span = (piece: CollagePiece, index: number) => {
	if (piece.kind === 'photo') return index % 3 === 0 ? 'wide' : 'medium';
	if (piece.kind === 'text') return piece.span ?? 'medium';
	return index % 2 === 0 ? 'medium' : 'narrow';
};
---

<main class="page-shell landing-shell">
	<header class="page-head landing-head">
		<p class="landing-kicker">Personal scrapbook</p>
		<h1>{site.profile.name}</h1>
		<p>{site.profile.shortBio}</p>
	</header>

	<div class="landing-collage">
		{
			welcomePhoto ? (
				<figure class="landing-scrap landing-scrap--welcome landing-rot--welcome">
					<div class="landing-frame landing-frame--welcome">
						<img src={welcomePhoto.src} alt={welcomePhoto.alt} width="1100" height="760" fetchpriority="high" />
					</div>
					<figcaption>
						<strong>Welcome in.</strong>
						<span>{intro?.body ?? welcomePhoto.caption}</span>
					</figcaption>
				</figure>
			) : null
		}

		{
			collagePieces.map((piece, index) => {
				const rotClass = rotationClass(index);
				const pieceSpan = span(piece, index);

				if (piece.kind === 'photo') {
					return (
						<figure class={`landing-scrap landing-scrap--${pieceSpan} ${rotClass}`}>
							<div class="landing-frame">
								<img src={piece.src} alt={piece.alt} loading="lazy" width="800" height="600" />
							</div>
							{piece.caption ? <figcaption>{piece.caption}</figcaption> : null}
						</figure>
					);
				}

				if (piece.kind === 'text') {
					return (
						<aside class={`landing-scrap landing-note landing-scrap--${pieceSpan} ${rotClass}`}>
							<p>{piece.body}</p>
						</aside>
					);
				}

				if (piece.kind === 'linkCard') {
					return (
						<div class={`landing-scrap landing-scrap--${pieceSpan} ${rotClass}`}>
							<a class="landing-note landing-note--link" href={piece.href}>
								<span>{piece.eyebrow}</span>
								<strong>{piece.title}</strong>
								<p>{piece.text}</p>
							</a>
						</div>
					);
				}

				return null;
			})
		}
	</div>
</main>

<style>
	.landing-shell {
		max-width: 76rem;
	}

	.landing-head {
		margin-bottom: 1.75rem;
	}

	.landing-kicker {
		margin: 0 0 0.35rem;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.landing-collage {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 1.25rem;
		align-items: start;
	}

	.landing-scrap {
		margin: 0;
		grid-column: span 12;
		transform: rotate(var(--rot, 0deg));
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.landing-scrap:hover {
		transform: rotate(var(--rot, 0deg)) translateY(-3px);
	}

	.landing-rot--welcome {
		--rot: -1.2deg;
	}

	.landing-rot--0 {
		--rot: -2deg;
	}

	.landing-rot--1 {
		--rot: 1.5deg;
	}

	.landing-rot--2 {
		--rot: -1.2deg;
	}

	.landing-rot--3 {
		--rot: 0.8deg;
	}

	.landing-rot--4 {
		--rot: 2deg;
	}

	.landing-rot--5 {
		--rot: -0.7deg;
	}

	.landing-rot--6 {
		--rot: 1.1deg;
	}

	.landing-scrap--welcome {
		grid-column: span 12;
	}

	@media (min-width: 640px) {
		.landing-scrap--narrow {
			grid-column: span 5;
		}

		.landing-scrap--medium {
			grid-column: span 7;
		}

		.landing-scrap--wide,
		.landing-scrap--welcome {
			grid-column: span 12;
		}
	}

	@media (min-width: 960px) {
		.landing-scrap--narrow {
			grid-column: span 4;
		}

		.landing-scrap--medium {
			grid-column: span 5;
		}

		.landing-scrap--wide {
			grid-column: span 8;
		}

		.landing-scrap--welcome {
			grid-column: span 8;
		}
	}

	.landing-frame {
		border-radius: var(--radius-md);
		overflow: hidden;
		border: 1px solid rgba(28, 27, 25, 0.08);
		box-shadow: var(--shadow);
		background: rgba(255, 253, 248, 0.9);
	}

	.landing-frame img {
		width: 100%;
		aspect-ratio: 5 / 4;
		object-fit: cover;
	}

	.landing-frame--welcome img {
		aspect-ratio: 16 / 10;
	}

	.landing-scrap figcaption {
		margin-top: 0.6rem;
		font-family: var(--font-serif);
		font-size: 1.02rem;
		color: var(--ink-muted);
		max-width: 42ch;
		line-height: 1.45;
	}

	.landing-scrap--welcome figcaption {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		max-width: 54ch;
		font-size: 1.08rem;
	}

	.landing-scrap--welcome figcaption strong {
		font-family: var(--font-serif);
		font-size: clamp(1.55rem, 3vw, 2.35rem);
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.04em;
		color: var(--ink);
	}

	.landing-note {
		display: block;
		padding: 1rem 1.05rem;
		border-radius: var(--radius-md);
		border: 1px solid rgba(28, 27, 25, 0.08);
		box-shadow: var(--shadow);
		background: rgba(255, 253, 248, 0.9);
		text-decoration: none;
	}

	.landing-note p {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.02rem;
		color: var(--ink-muted);
		line-height: 1.45;
	}

	.landing-note--link span {
		display: block;
		margin-bottom: 0.35rem;
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.landing-note--link strong {
		display: block;
		font-family: var(--font-serif);
		font-size: 1.45rem;
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.04em;
		color: var(--ink);
	}

	.landing-note--link p {
		margin-top: 0.55rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.landing-scrap,
		.landing-scrap:hover {
			transform: none;
			transition: none;
		}
	}
</style>
