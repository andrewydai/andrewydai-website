---
export type SocialSymbol = 'github' | 'linkedin' | 'email' | 'resume';

interface Props {
	symbol: SocialSymbol;
}

const { symbol } = Astro.props;
---

<svg class="page-symbol__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
	{symbol === 'github' && (
		<g transform="translate(12 12) scale(0.88) translate(-12 -12)">
			<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.3-2 2.8-.3 5.5-1.4 5.5-6.4 0-1.3-.5-2.5-1.3-3.4.1-.3.6-1.5-.1-3.1 0 0-1-.3-3.4 1.3a11.6 11.6 0 0 0-6.2 0C4.9 3.6 3.9 3.9 3.9 3.9c-.7 1.6-.2 2.8-.1 3.1-.8.9-1.3 2.1-1.3 3.4 0 5 2.7 6.1 5.5 6.4-.4.4-.4.9-.4 1.4V21" />
		</g>
	)}
	{symbol === 'email' && (
		<>
			<rect x="3" y="5" width="18" height="14" rx="2" />
			<path d="m3 7 9 12 9-5 9 5-9Z" />
		</>
	)}
	{symbol === 'linkedin' && (
		<>
			<rect x="5" y="5" width="14" height="14" rx="2" />
			<path d="M9 10v7" />
			<circle cx="9" cy="7.5" r="0.75" fill="currentColor" stroke="none" />
			<path d="M13 17v-4.2a2.2 2.2 0 0 1 4.4 0V17" />
		</>
	)}
	{symbol === 'resume' && (
		<>
			<path d="M14 5H9a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V7l-3-3Z" />
			<path d="M14 5v3h3" />
			<path d="M10 11h4" />
			<path d="M10 15h3" />
		</>
	)}
</svg>
