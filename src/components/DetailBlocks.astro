---
import type { DetailBlock } from '../types/content';

interface Props {
	blocks: DetailBlock[];
}

const { blocks } = Astro.props;
---

<div class="detail-blocks">
	{
		blocks.map((block) => {
			if (block.type === 'paragraph') {
				return <p class="detail-p">{block.text}</p>;
			}
			if (block.type === 'image') {
				return (
					<figure class="detail-fig">
						<img
							src={block.src}
							alt={block.alt}
							width="1200"
							height="800"
							loading="lazy"
							decoding="async"
						/>
						{block.caption ? <figcaption>{block.caption}</figcaption> : null}
					</figure>
				);
			}
			if (block.type === 'link') {
				const external = block.href.startsWith('http');
				return (
					<p class="detail-link-wrap">
						<a
							href={block.href}
							class="detail-link"
							target={external ? '_blank' : undefined}
							rel={external ? 'noreferrer noopener' : undefined}
						>
							{block.label}
						</a>
					</p>
				);
			}
			if (block.type === 'split') {
				const pos = block.mediaPosition ?? 'start';
				return (
					<div class="detail-split" data-media-position={pos}>
						<div class="detail-split__media">
							<figure class="detail-fig">
								<img
									src={block.media.src}
									alt={block.media.alt}
									width="1200"
									height="800"
									loading="lazy"
									decoding="async"
								/>
								{block.media.caption ? <figcaption>{block.media.caption}</figcaption> : null}
							</figure>
						</div>
						<div class="detail-split__content">
							{block.content.map((item) => {
								if (item.type === 'paragraph') {
									return <p class="detail-p">{item.text}</p>;
								}
								if (item.type === 'link') {
									const ext = item.href.startsWith('http');
									return (
										<p class="detail-link-wrap">
											<a
												href={item.href}
												class="detail-link"
												target={ext ? '_blank' : undefined}
												rel={ext ? 'noreferrer noopener' : undefined}
											>
												{item.label}
											</a>
										</p>
									);
								}
								return null;
							})}
						</div>
					</div>
				);
			}
			return null;
		})
	}
</div>

<style>
	.detail-blocks {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-top: 0.25rem;
	}

	.detail-p {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.98rem;
		font-family: var(--font-serif), var(--font-emoji);
	}

	.detail-fig {
		margin: 0;
		border-radius: var(--radius-md);
		overflow: hidden;
		border: 1px solid rgba(31, 107, 86, 0.14);
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.65), rgba(42, 143, 114, 0.04));
	}

	.detail-fig img {
		display: block;
		width: 100%;
		height: auto;
	}

	.detail-fig figcaption {
		padding: 0.5rem 0.75rem 0.65rem;
		font-size: 0.85rem;
		color: var(--ink-muted);
	}

	.detail-split {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.detail-split[data-media-position='end'] {
		flex-direction: column-reverse;
	}

	.detail-split__content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-width: 0;
	}

	@media (min-width: 40em) {
		.detail-split {
			flex-direction: row;
			align-items: flex-start;
			gap: 1.15rem 1.35rem;
		}

		.detail-split[data-media-position='end'] {
			flex-direction: row-reverse;
		}

		.detail-split__media {
			flex: 0 1 44%;
			max-width: min(22rem, 46%);
			min-width: 0;
		}

		.detail-split__content {
			flex: 1 1 0;
		}
	}

	.detail-link-wrap {
		margin: 0;
	}

	.detail-link {
		font-weight: 600;
		font-size: 0.95rem;
	}
</style>
