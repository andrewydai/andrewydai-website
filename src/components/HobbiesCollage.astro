---
import type { HobbyItem } from '../types/content';

interface Props {
	items: HobbyItem[];
}

const { items } = Astro.props;
---

<div class="hobby-collage">
	{
		items.map((item) => {
			const rot = item.rotation ?? 0;
			const span = item.span ?? 'medium';
			const imageSize = item.image.size ?? 'medium';
			const linkLabel = item.linkLabel ?? 'YouTube';

			return (
				<figure
					class:list={[
						'hobby-scrap',
						`hobby-scrap--${span}`,
						`hobby-scrap--img-${imageSize}`,
						{ 'hobby-scrap--link': item.href },
					]}
					style={`--rot:${rot}deg`}
				>
					{
						item.href ? (
							<a
								class="hobby-scrap__media"
								href={item.href}
								target="_blank"
								rel="noreferrer noopener"
								aria-label={`${item.blurb} — ${linkLabel}`}
							>
								<div class="hobby-frame">
									<img src={item.image.src} alt={item.image.alt} loading="lazy" width="800" height="600" />
								</div>
								<span class="hobby-scrap__badge">{linkLabel}</span>
							</a>
						) : (
							<div class="hobby-scrap__media">
								<div class="hobby-frame">
									<img src={item.image.src} alt={item.image.alt} loading="lazy" width="800" height="600" />
								</div>
							</div>
						)
					}
					<figcaption>{item.blurb}</figcaption>
				</figure>
			);
		})
	}
</div>

<style>
	.hobby-collage {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 1.25rem;
		align-items: start;
	}

	.hobby-scrap {
		margin: 0;
		grid-column: span 12;
		transform: rotate(var(--rot, 0deg));
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.hobby-scrap:hover {
		transform: rotate(var(--rot, 0deg)) translateY(-3px);
	}

	.hobby-scrap__media {
		display: block;
		position: relative;
		text-decoration: none;
		color: inherit;
	}

	.hobby-scrap--link .hobby-scrap__media {
		cursor: pointer;
	}

	.hobby-scrap--link .hobby-scrap__media:hover .hobby-frame,
	.hobby-scrap--link .hobby-scrap__media:focus-visible .hobby-frame {
		border-color: var(--accent-border);
		box-shadow: var(--shadow-hover);
	}

	.hobby-scrap--link .hobby-scrap__media:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
		border-radius: var(--radius-md);
	}

	.hobby-scrap__badge {
		position: absolute;
		right: 0.55rem;
		bottom: 0.55rem;
		padding: 0.22rem 0.5rem;
		border-radius: 999px;
		background: rgba(23, 21, 18, 0.82);
		color: #fff;
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
		pointer-events: none;
	}

	.hobby-scrap--link .hobby-scrap__media:hover .hobby-scrap__badge,
	.hobby-scrap--link .hobby-scrap__media:focus-visible .hobby-scrap__badge {
		opacity: 1;
		transform: translateY(0);
	}

	@media (min-width: 640px) {
		.hobby-scrap--narrow {
			grid-column: span 5;
		}

		.hobby-scrap--medium {
			grid-column: span 7;
		}

		.hobby-scrap--wide {
			grid-column: span 12;
		}
	}

	@media (min-width: 960px) {
		.hobby-scrap--narrow {
			grid-column: span 4;
		}

		.hobby-scrap--medium {
			grid-column: span 5;
		}

		.hobby-scrap--wide {
			grid-column: span 8;
		}
	}

	.hobby-frame {
		border-radius: var(--radius-md);
		overflow: hidden;
		border: 1px solid rgba(28, 27, 25, 0.08);
		box-shadow: var(--shadow);
		background: rgba(255, 253, 248, 0.9);
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.hobby-frame img {
		width: 100%;
		object-fit: cover;
		display: block;
	}

	.hobby-scrap--img-small .hobby-frame img {
		aspect-ratio: 4 / 3;
		max-height: 11.5rem;
	}

	.hobby-scrap--img-medium .hobby-frame img {
		aspect-ratio: 5 / 4;
		max-height: 15rem;
	}

	.hobby-scrap--img-large .hobby-frame img {
		aspect-ratio: 16 / 10;
		max-height: 20rem;
	}

	@media (min-width: 640px) {
		.hobby-scrap--img-small .hobby-frame img {
			max-height: 13rem;
		}

		.hobby-scrap--img-medium .hobby-frame img {
			max-height: 17rem;
		}

		.hobby-scrap--img-large .hobby-frame img {
			max-height: 24rem;
		}
	}

	.hobby-scrap figcaption {
		margin-top: 0.6rem;
		font-family: var(--font-serif), var(--font-emoji);
		font-size: 1.02rem;
		color: var(--ink-muted);
		max-width: 36ch;
		line-height: 1.45;
	}
</style>
